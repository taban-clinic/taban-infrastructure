#!/usr/bin/env bash
# Paved path for "every issue gets its own worktree branch off dev".
#
#   scripts/new-issue <issue-number> [slug]      # branch feat/<num>-<slug>
#   scripts/new-issue <slug>                     # branch feat/<slug> (no issue #)
#
# Creates a worktree at .worktrees/<branch>/ off the freshest origin/dev,
# copies identity files (.sid-identity + .envrc — worktrees do NOT inherit them),
# and runs `direnv allow`. Prints the cd line at the end.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

arg1="${1:-}"; arg2="${2:-}"
[ -z "$arg1" ] && { echo "usage: scripts/new-issue <issue-number> [slug]  |  scripts/new-issue <slug>" >&2; exit 1; }

if [[ "$arg1" =~ ^[0-9]+$ ]]; then
  slug="${arg2:-issue-$arg1}"
  branch="feat/${arg1}-${slug}"
else
  branch="feat/${arg1}"
fi
branch="${branch// /-}"

wt=".worktrees/${branch}"
[ -e "$wt" ] && { echo "✗ worktree already exists: $wt" >&2; exit 1; }

git fetch -q origin dev
echo "→ worktree $wt  (branch $branch off origin/dev)"
git worktree add -b "$branch" "$wt" origin/dev

# Worktrees don't inherit identity — copy it in (see global CLAUDE.md § Identity).
for f in .sid-identity .envrc; do
  [ -f "$root/$f" ] && cp "$root/$f" "$wt/$f"
done
( cd "$wt" && command -v direnv >/dev/null && direnv allow . || true )

echo "✓ ready. Enter it with:"
echo "    cd $root/$wt"
