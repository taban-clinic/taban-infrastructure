#!/usr/bin/env bash
# Release helper — the ONLY sanctioned way the released branch (main/master) moves.
#
#   scripts/promote vX.Y.Z ["release note"]
#
# Tags the current dev commit, fast-forwards the released branch to it, and pushes
# both together. The pre-push hook allows the update precisely because the commit
# now carries a v* tag. Anything else that tries to touch it is rejected.
set -euo pipefail

tag="${1:-}"
note="${2:-}"
[ -z "$tag" ] && { echo "usage: scripts/promote vX.Y.Z [\"note\"]" >&2; exit 1; }
case "$tag" in v[0-9]*) : ;; *) echo "✗ tag must look like vX.Y.Z (got '$tag')" >&2; exit 1;; esac

# Released branch: main unless this repo genuinely uses master. Check the remote
# first, then fall back to whichever LOCAL branch exists. On a FIRST release the
# released branch has never been pushed, so refs/remotes/origin/main is legitimately
# absent — the old `|| released="master"` read that as "this is a master repo" and
# sent the fetch below after a ref that does not exist.
released="main"
if git show-ref --verify --quiet refs/remotes/origin/master \
   || { ! git show-ref --verify --quiet refs/heads/main \
        && git show-ref --verify --quiet refs/heads/master; }; then
  released="master"
fi

git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null \
  && { echo "✗ tag $tag already exists" >&2; exit 1; }

# Refuse to release a dirty tree.
git diff --quiet && git diff --cached --quiet \
  || { echo "✗ working tree is dirty — commit or stash first" >&2; exit 1; }

git fetch -q origin dev
git fetch -q origin "$released" 2>/dev/null || true   # absent on a first release

# Release the tip of origin/dev (the integration line), not whatever's checked out.
dev_sha=$(git rev-parse origin/dev)

# The released branch must be an ancestor of dev, else a fast-forward isn't possible.
# On a first release there is no remote released branch to fast-forward FROM, so the
# check is vacuous — but the local branch, if present, must still be an ancestor.
if rel_sha=$(git rev-parse --verify --quiet "refs/remotes/origin/$released"); then
  base_desc="origin/$released"
elif rel_sha=$(git rev-parse --verify --quiet "refs/heads/$released"); then
  base_desc="local $released (first release — not pushed yet)"
else
  rel_sha=""; base_desc=""
fi

if [ -n "$rel_sha" ] && ! git merge-base --is-ancestor "$rel_sha" "$dev_sha"; then
  echo "✗ $base_desc is not an ancestor of origin/dev — cannot fast-forward." >&2
  echo "  Reconcile first (the released branch should only ever trail dev)." >&2
  exit 1
fi
if [ -n "$base_desc" ]; then echo "→ base: $base_desc"; fi

echo "→ tagging $dev_sha as $tag"
git tag -a "$tag" "$dev_sha" -m "${note:-release $tag}"

echo "→ fast-forwarding $released → $tag"
git branch -f "$released" "$dev_sha"

echo "→ pushing $released + $tag"
git push origin "refs/heads/$released:refs/heads/$released" "refs/tags/$tag"

echo "✓ promoted: $released is now $tag ($dev_sha)"
